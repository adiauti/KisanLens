# Example environment variables for local development and deployment

# Optional AI provider key (used by server-side scan API)
ANTHROPIC_API_KEY=

# Supabase (if used) - set in Vercel project settings for deployment
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public runtime flags
NEXT_PUBLIC_SOME_FLAG=true
# Example environment variables for local development
# If you have an Anthropic API key, set it to enable server-side image analysis.
ANTHROPIC_API_KEY=
